# Copy to .env.local for local development, and set the same variables in your host (e.g. Vercel → Settings → Environment Variables).

# Resend (https://resend.com) API key for the contact and group-training forms.
# Without it, submissions are logged to the console in development and fail gracefully in production
# (visitors are shown the email address and phone number instead).
RESEND_API_KEY=

# Sender address on a domain verified in Resend.
MAIL_FROM="SUMHLC Website <forms@sumhlc.org>"

# Optional: where form submissions are delivered. Defaults to the site email in src/config/site.ts.
MAIL_TO=
